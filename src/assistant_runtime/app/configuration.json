{
  "version": 1,
  "namespace": "",
  "title": "基础与能力装配",
  "group": "access",
  "schema": {
    "type": "object",
    "properties": {
      "root": {
        "type": "string",
        "title": "root",
        "readOnly": true,
        "description": "由本机部署维护；需要安装、路径检查或数据迁移。",
        "x-advanced": true
      },
      "profile": {
        "type": "string",
        "title": "运行入口",
        "default": "headless",
        "x-advanced": true
      },
      "backend": {
        "type": "string",
        "title": "backend",
        "default": "pi",
        "readOnly": true,
        "description": "由本机部署维护；需要安装、路径检查或数据迁移。",
        "x-advanced": true
      },
      "pi_binary": {
        "type": "string",
        "title": "pi_binary",
        "default": "pi",
        "readOnly": true,
        "description": "由本机部署维护；需要安装、路径检查或数据迁移。",
        "x-advanced": true
      },
      "instance_skills": {
        "type": "array",
        "title": "实例技能",
        "default": [],
        "items": {},
        "x-advanced": true
      },
      "main_model": {
        "type": "string",
        "title": "主对话模型别名",
        "default": "unconfigured",
        "x-group": "models",
        "x-reference": "model_api.entries"
      },
      "main_reasoning_effort": {
        "type": "string",
        "title": "主对话思考深度",
        "default": "auto",
        "enum": [
          "auto",
          "none",
          "minimal",
          "low",
          "medium",
          "high",
          "xhigh",
          "max",
          "ultra"
        ],
        "x-group": "models"
      },
      "model_dir": {
        "type": "string",
        "title": "model_dir",
        "default": "",
        "readOnly": true,
        "description": "由本机部署维护；需要安装、路径检查或数据迁移。",
        "x-advanced": true
      },
      "unit_name": {
        "type": "string",
        "title": "unit_name",
        "default": "personal-agent.service",
        "readOnly": true,
        "description": "由本机部署维护；需要安装、路径检查或数据迁移。",
        "x-advanced": true
      },
      "plugins": {
        "type": "array",
        "title": "启用插件",
        "default": [
          "ai_usage",
          "workfiles",
          "devices",
          "assistant",
          "conversation",
          "cli",
          "execution",
          "models",
          "voice_disabled",
          "pi",
          "notifications",
          "tasks",
          "web"
        ],
        "items": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "maxItems": 64,
        "uniqueItems": true,
        "x-group": "plugins"
      },
      "bindings": {
        "type": "object",
        "title": "能力绑定",
        "default": {
          "audio": "pipewire",
          "trigger": "voice_disabled",
          "brain": "pi",
          "memory": "memory"
        },
        "additionalProperties": {}
      },
      "pi_shell": {
        "type": "string",
        "title": "命令工具",
        "default": "auto",
        "enum": [
          "auto",
          "bash",
          "powershell"
        ],
        "description": "auto 在 Windows 使用 PowerShell，在 Linux 使用 Bash；只影响本实例。",
        "x-group": "execution"
      },
      "plugin_backends": {
        "type": "object",
        "title": "平台默认实现",
        "default": {},
        "x-group": "plugins",
        "x-advanced": true,
        "additionalProperties": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "linux": {
              "type": "string"
            },
            "windows": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "application": {
    "*": "restart",
    "main_model": "boundary",
    "main_reasoning_effort": "boundary",
    "instance_skills": "boundary",
    "plugin_backends": "boundary"
  }
}
