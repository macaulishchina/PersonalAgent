{
  "version": 1,
  "namespace": "web",
  "title": "聊天网页",
  "group": "access",
  "schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "enable": {
        "type": "boolean",
        "title": "启用",
        "default": false
      },
      "host": {
        "type": "string",
        "title": "内部传输地址",
        "default": "127.0.0.1",
        "description": "仅用于管理服务与聊天插件之间的本机通信；对外访问地址在实例管理中设置。",
        "x-advanced": true
      },
      "port": {
        "type": "integer",
        "title": "内部传输端口",
        "default": 0,
        "minimum": 0,
        "maximum": 65535,
        "description": "通常保持 0，由系统分配。聊天与配置统一通过实例管理端口访问。",
        "x-advanced": true
      },
      "token_file": {
        "type": "string",
        "title": "访问凭据文件",
        "default": "",
        "readOnly": true,
        "description": "由本机部署维护，修改前需检查路径或访问配置。"
      }
    },
    "x-listeners": [
      {
        "host": "host",
        "port": "port",
        "enabled": "enable"
      }
    ]
  },
  "requires": [
    "conversation"
  ],
  "application": {
    "*": "boundary"
  }
}
