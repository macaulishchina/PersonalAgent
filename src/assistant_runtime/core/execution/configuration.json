{
  "version": 1,
  "namespace": "execution",
  "title": "公共执行",
  "group": "execution",
  "schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "concurrency": {
        "type": "integer",
        "title": "并发执行数量",
        "default": 16,
        "minimum": 1,
        "maximum": 64,
        "description": "所有会话、后台任务和辅助推理共用同一执行名额池，等待队列不设长度上限。上限 64，适宜值取决于本机内存和模型服务限额。"
      },
      "controllers": {
        "type": "object",
        "title": "可信执行控制服务",
        "description": "仅显式信任的已安装插件可签发资源授权；每项列出其可代表的资源所有者，不支持通配符。模型工具不能使用此控制入口。",
        "default": {},
        "advanced": true,
        "additionalProperties": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "requires": [
    "pi",
    "ai_usage",
    "workfiles"
  ],
  "application": {
    "*": "immediate"
  }
}
