{
  "version": 1,
  "namespace": "execution",
  "title": "公共执行",
  "group": "execution",
  "schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "concurrency": {
        "type": "integer",
        "title": "并发执行数量",
        "default": 4,
        "minimum": 1,
        "maximum": 8
      },
      "queue_size": {
        "type": "integer",
        "title": "排队容量",
        "default": 64,
        "minimum": 1,
        "maximum": 1024
      }
    }
  },
  "requires": [
    "pi",
    "ai_usage",
    "workfiles"
  ],
  "application": {
    "*": "immediate"
  }
}
