{
  "version": 1,
  "namespace": "model_api",
  "title": "模型与账号",
  "group": "models",
  "schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "enabled": {
        "type": "boolean",
        "title": "启用",
        "default": false
      },
      "concurrency": {
        "type": "integer",
        "title": "并发数量",
        "default": 4,
        "minimum": 1,
        "maximum": 16
      },
      "queue_size": {
        "type": "integer",
        "title": "队列容量",
        "default": 16,
        "minimum": 1,
        "maximum": 64
      },
      "timeout_seconds": {
        "type": "integer",
        "title": "请求超时（秒）",
        "default": 600,
        "minimum": 1,
        "maximum": 3600,
        "x-advanced": true
      },
      "compaction_timeout_seconds": {
        "type": "integer",
        "title": "上下文压缩超时（秒）",
        "default": 600,
        "minimum": 1,
        "maximum": 3600,
        "x-advanced": true
      },
      "tool_result_max_chars": {
        "type": "integer",
        "title": "工具结果文本上限",
        "default": 6000,
        "x-advanced": true,
        "minimum": 1,
        "maximum": 50000
      },
      "max_loaded_tools": {
        "type": "integer",
        "title": "单次工具加载上限",
        "default": 12,
        "x-advanced": true,
        "minimum": 1,
        "maximum": 64
      },
      "max_output_tokens": {
        "type": "integer",
        "title": "辅助调用单次输出上限",
        "default": 0,
        "minimum": 0,
        "maximum": 16384,
        "x-advanced": true,
        "description": "0 表示不指定单次输出上限，由供应商／Pi 原生适配决定；与累计用量限制独立。"
      },
      "execution_max_output_tokens": {
        "type": "integer",
        "title": "执行单次输出上限",
        "default": 0,
        "minimum": 0,
        "maximum": 131072,
        "x-advanced": true,
        "description": "0 表示不指定单次输出上限，由供应商／Pi 原生适配决定；与累计用量限制独立。"
      },
      "providers": {
        "type": "object",
        "title": "服务供应商",
        "default": {},
        "additionalProperties": {
          "type": "object",
          "properties": {
            "preset": {
              "type": "string",
              "title": "预设接口",
              "enum": [
                "openai",
                "claude",
                "gemini",
                "deepseek",
                "opencode_responses",
                "opencode_chat",
                "opencode_anthropic",
                "opencode_gemini",
                "opencode_go_responses",
                "opencode_go_chat",
                "opencode_go_anthropic",
                "opencode_go_gemini"
              ]
            },
            "account": {
              "type": "string",
              "title": "供应商认证配置",
              "x-reference": "model_api.accounts"
            },
            "enabled": {
              "type": "boolean",
              "title": "启用供应商"
            },
            "protocol": {
              "type": "string",
              "title": "自定义协议",
              "enum": [
                "openai_responses",
                "openai_chat",
                "anthropic",
                "gemini"
              ],
              "x-advanced": true
            },
            "base_url": {
              "type": "string",
              "title": "自定义接口地址",
              "x-advanced": true
            },
            "key_env": {
              "type": "string",
              "title": "凭据环境变量名称"
            },
            "auth_scheme": {
              "type": "string",
              "title": "鉴权方式",
              "enum": [
                "native",
                "bearer"
              ]
            },
            "session_header": {
              "type": "string",
              "title": "会话请求头"
            },
            "catalog": {
              "type": "object",
              "title": "模型目录",
              "x-advanced": true,
              "required": [
                "url",
                "format"
              ],
              "additionalProperties": false,
              "properties": {
                "url": {
                  "type": "string",
                  "title": "模型目录地址",
                  "description": "完整目录地址，须与推理接口同源；不改变推理地址。"
                },
                "format": {
                  "type": "string",
                  "title": "目录响应格式",
                  "enum": [
                    "openai",
                    "anthropic",
                    "gemini"
                  ]
                }
              }
            }
          },
          "additionalProperties": false
        },
        "propertyNames": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        }
      },
      "accounts": {
        "type": "object",
        "title": "供应商认证",
        "default": {},
        "additionalProperties": {
          "type": "object",
          "properties": {
            "provider": {
              "type": "string",
              "title": "Pi 供应商标识"
            },
            "auth": {
              "type": "string",
              "title": "认证方式",
              "enum": [
                "oauth",
                "api_key"
              ]
            },
            "key_env": {
              "type": "string",
              "title": "可选 API Key 环境变量引用"
            },
            "output_limit": {
              "type": "string",
              "title": "输出上限方式",
              "enum": [
                "request",
                "model"
              ],
              "x-advanced": true
            }
          },
          "required": [
            "provider",
            "auth"
          ],
          "additionalProperties": false
        },
        "propertyNames": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        }
      },
      "entries": {
        "type": "object",
        "title": "模型别名",
        "default": {},
        "additionalProperties": {
          "type": "object",
          "properties": {
            "provider": {
              "type": "string",
              "title": "供应商",
              "x-reference": "model_api.providers"
            },
            "model": {
              "type": "string",
              "title": "实际模型名称"
            },
            "reasoning_efforts": {
              "type": "array",
              "title": "模型支持的思考深度",
              "items": {
                "type": "string",
                "enum": [
                  "none",
                  "minimal",
                  "low",
                  "medium",
                  "high",
                  "xhigh",
                  "max",
                  "ultra"
                ]
              },
              "x-advanced": true
            },
            "default_reasoning_effort": {
              "type": "string",
              "title": "默认思考深度",
              "enum": [
                "auto",
                "none",
                "minimal",
                "low",
                "medium",
                "high",
                "xhigh",
                "max",
                "ultra"
              ]
            },
            "images": {
              "type": "boolean",
              "title": "支持图片"
            },
            "structured": {
              "type": "boolean",
              "title": "支持结构化结果"
            },
            "context_window": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000000,
              "title": "上下文窗口",
              "x-advanced": true
            },
            "max_output_tokens": {
              "type": "integer",
              "minimum": 0,
              "maximum": 16384,
              "title": "辅助调用输出上限",
              "x-advanced": true,
              "description": "0 表示不指定单次输出上限；未填写时继承全局设置。"
            },
            "execution_max_output_tokens": {
              "type": "integer",
              "minimum": 0,
              "maximum": 131072,
              "title": "执行输出上限",
              "x-advanced": true,
              "description": "0 表示不指定单次输出上限；未填写时继承全局设置。"
            },
            "capabilities": {
              "type": "object",
              "title": "模型资料来源",
              "properties": {
                "binding": {
                  "type": "string"
                },
                "source": {
                  "type": "string"
                },
                "revision": {
                  "type": "string"
                },
                "reference": {
                  "type": "string"
                },
                "images": {
                  "type": "boolean"
                },
                "structured": {
                  "type": "boolean"
                },
                "tools": {
                  "type": "boolean"
                },
                "reasoning": {
                  "type": "boolean"
                },
                "context_window": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10000000
                },
                "output_limit": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10000000
                },
                "reasoning_efforts": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "none",
                      "minimal",
                      "low",
                      "medium",
                      "high",
                      "xhigh",
                      "max"
                    ]
                  }
                }
              },
              "additionalProperties": false,
              "x-advanced": true
            },
            "output_limit": {
              "type": "integer",
              "title": "模型最大输出",
              "description": "模型支持的最大输出 token 数；实际调用还受运行预算限制。",
              "minimum": 1,
              "maximum": 10000000
            }
          },
          "additionalProperties": false
        },
        "propertyNames": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$",
          "description": "模型名称须以英文字母开头，可包含字母、数字、点号、下划线或连字符，最多 64 个字符；请检查“在 PA 中的名称”。"
        }
      },
      "memory": {
        "type": "string",
        "title": "记忆整理模型",
        "default": "",
        "x-reference": "model_api.entries"
      }
    }
  },
  "interface": {
    "title": "模型与账号",
    "fields": {
      "accounts": {
        "title": "1. 账号与认证",
        "order": 0
      },
      "providers": {
        "title": "2. 连接供应商",
        "order": 1
      },
      "entries": {
        "title": "3. 可用模型",
        "order": 2
      },
      "enabled": {
        "title": "启用模型服务",
        "order": 3
      },
      "memory": {
        "title": "记忆使用的模型",
        "order": 4
      },
      "concurrency": {
        "advanced": true,
        "order": 20
      },
      "queue_size": {
        "advanced": true,
        "order": 20
      },
      "timeout_seconds": {
        "advanced": true,
        "order": 20
      },
      "compaction_timeout_seconds": {
        "advanced": true,
        "order": 20
      },
      "tool_result_max_chars": {
        "advanced": true,
        "order": 20
      },
      "max_loaded_tools": {
        "advanced": true,
        "order": 20
      },
      "max_output_tokens": {
        "advanced": true,
        "order": 20
      },
      "execution_max_output_tokens": {
        "advanced": true,
        "order": 20
      }
    }
  },
  "requires": [
    "ai_usage"
  ],
  "application": {
    "*": "boundary"
  }
}
