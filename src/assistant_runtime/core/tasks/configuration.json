{
  "version": 1,
  "namespace": "tasks",
  "title": "后台任务",
  "group": "conversation",
  "schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "timezone": {
        "type": "string",
        "title": "时区",
        "default": "Asia/Shanghai"
      },
      "concurrency": {
        "type": "integer",
        "title": "并发数量",
        "default": 2,
        "minimum": 1,
        "maximum": 8
      },
      "misfire_seconds": {
        "type": "integer",
        "title": "计划迟到容忍（秒）",
        "default": 300,
        "minimum": 0,
        "maximum": 86400
      },
      "max_goal_rounds": {
        "type": "integer",
        "title": "长期目标轮次上限",
        "default": 8,
        "minimum": 1,
        "maximum": 64
      },
      "execution": {
        "type": "object",
        "title": "默认执行选型",
        "default": {
          "model": "auto",
          "reasoning_effort": "auto"
        },
        "additionalProperties": {}
      },
      "model_policy": {
        "type": "object",
        "title": "模型选择与回退",
        "default": {},
        "additionalProperties": {}
      }
    }
  },
  "requires": [
    "execution",
    "pi",
    "notifications",
    "workfiles"
  ],
  "application": {
    "*": "boundary"
  }
}
